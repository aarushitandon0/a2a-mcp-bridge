# Build context is the repo root (see demo/docker-compose.yml's `context: ..`)
# -- this image is one of three identical bridge instances in the M4 demo;
# they differ only by the BRIDGE_INSTANCE_ID env var set per-service in
# docker-compose.yml, never by anything baked into the image itself. That's
# the property M4 exists to prove: any instance can serve any request.
FROM python:3.12-slim

WORKDIR /app

COPY pyproject.toml ./
COPY src ./src

RUN pip install --no-cache-dir .

EXPOSE 8000

CMD ["python", "-m", "uvicorn", "bridge.server:app_from_env", "--factory", "--host", "0.0.0.0", "--port", "8000"]
